# 복사해서 .env 로 쓴다. .env 는 커밋하지 않는다 (.gitignore 에 포함됨)
# 데이터 내려받기 스크립트가 여기서 AIHUB_APIKEY 를 읽는다.
# 경로 서버(server/app.py)는 이 파일을 직접 읽지 않고 환경변수 KAKAO_REST_API_KEY 를 읽으므로, 띄우기 전에 환경변수로 넘긴다.

# 카카오 디벨로퍼스 앱의 REST API 키. 대중교통 경로 조회(GET /routes/transit)에 쓴다.
#   발급: https://developers.kakao.com/console/app → 앱 만들기 → 플랫폼 키의 REST API 키
#   사용 설정: 앱 화면 왼쪽 메뉴(창이 좁으면 ☰ 메뉴)의 제품 설정 > 카카오맵 > 사용 설정 > 상태 ON
#             꺼져 있으면 경로 조회가 HTTP 403 (NotAuthorizedError) 으로 거절된다
#   무료 쿼터: 대중교통 경로 조회 하루 1,000건 (계정의 첫 번째 카카오맵 활성화 앱에만 제공)
KAKAO_REST_API_KEY=

# ODsay 키. 카카오맵 길찾기가 실패할 때 경로 서버가 쓰는 백업(server/odsay_transit.py)에 쓴다. 비워 두면 백업만 꺼진다.
#   발급: https://lab.odsay.com → 로그인 → Application → 애플리케이션 등록 (서버에서 부르므로 플랫폼은 Server, 경로 서버의 공인 IP 를 등록)
#   무료(Basic) 요금제: 하루 30회, 결제 수단 등록 없음. 경로 서버도 하루 횟수를 세어 30회에서 멈춘다 (환경변수 ODSAY_DAILY_LIMIT 로 바꿀 수 있다)
#   경로 서버는 카카오 키와 같이 이 파일을 직접 읽지 않으므로, 띄우기 전에 환경변수 ODSAY_API_KEY 로 넘긴다
ODSAY_API_KEY=

# AI-Hub 오픈 API 키 (aihubshell -mode d 에 필요). 각자 본인 계정으로 발급.
AIHUB_APIKEY=

# Hugging Face 토큰 (LoRA 어댑터를 private repo 에 올릴 때만 필요)
HF_TOKEN=
