# 복사해서 .env 로 쓴다. .env 는 커밋하지 않는다 (.gitignore 에 포함됨)
# 서버(server/app.py)가 시작할 때 저장소 루트의 .env 를 읽는다.

# 카카오 디벨로퍼스 앱의 REST API 키. 대중교통 경로 조회(/api/v1/route)에 쓴다.
#   발급: https://developers.kakao.com/console/app → 앱 만들기 → 플랫폼 키의 REST API 키
#   사용 설정: 앱 화면 왼쪽 메뉴(창이 좁으면 ☰ 메뉴)의 제품 설정 > 카카오맵 > 사용 설정 > 상태 ON
#             꺼져 있으면 경로 조회가 HTTP 403 (NotAuthorizedError) 으로 거절된다
#   무료 쿼터: 대중교통 경로 조회 하루 1,000건 (계정의 첫 번째 카카오맵 활성화 앱에만 제공)
KAKAO_REST_API_KEY=

# AI-Hub 오픈 API 키 (aihubshell -mode d 에 필요). 각자 본인 계정으로 발급.
AIHUB_APIKEY=

# Hugging Face 토큰 (LoRA 어댑터를 private repo 에 올릴 때만 필요)
HF_TOKEN=
