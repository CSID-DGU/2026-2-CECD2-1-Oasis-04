# 실제 서버와 실제 마이크를 쓰는 모드. 서버는 둘이다.
#   STT 서버  (저장소의 stt/api.py)      음성 인식 + 목적지 해석 + 현재 위치   기본 http://localhost:8001
#   경로 서버 (저장소의 server/app.py)   대중교통 경로 (KAKAO_REST_API_KEY 필요)  기본 http://localhost:8000
#   개발:  npm run dev:real    (http://localhost:5173. vite proxy 가 /api 는 STT 서버로, /routes 는 경로 서버로 넘긴다)
#   빌드:  npm run build:real  (dist/ 를 STT 서버가 함께 서빙한다. 이때는 아래 VITE_ROUTE_API_BASE_URL 에 경로 서버 주소를 적고,
#                               경로 서버가 화면의 출처를 허용(CORS)해야 한다)
VITE_USE_MOCK=false

# STT 서버 주소. 비워 두면 화면과 같은 출처로 요청한다. 다른 주소에 있으면 적는다. 예) VITE_API_BASE_URL=https://api.example.com
VITE_API_BASE_URL=

# 경로 서버 주소. 비워 두면 화면과 같은 출처로 요청한다 (개발 모드의 vite proxy)
VITE_ROUTE_API_BASE_URL=

# 서버 설정(stt/config.yaml 의 rag.kiosks)에 등록된 키오스크 ID
VITE_KIOSK_ID=KIOSK_JONGNO_01

# 타이머는 비워 두면 src/config.js 의 운영 기본값(30초/60초/10초/2.5초/60초, 녹음 상한 25초)이 쓰인다.
