# 실제 서버(저장소의 server/app.py: 음성 인식 + 목적지 해석 + 대중교통 경로)와 실제 마이크를 쓰는 모드.
#   개발:  npm run dev:real    (http://localhost:5173, /api 요청은 vite proxy 가 http://localhost:8000 으로 넘긴다)
#   빌드:  npm run build:real  (dist/ 를 서버가 함께 서빙한다 → http://localhost:8000 하나로 접속)
# 경로는 서버가 카카오맵 대중교통 경로 조회로 받아온다 (서버 .env 에 KAKAO_REST_API_KEY 필요).
VITE_USE_MOCK=false

# 비워 두면 화면과 같은 출처로 요청한다. 서버가 다른 주소에 있으면 적는다. 예) VITE_API_BASE_URL=https://api.example.com
VITE_API_BASE_URL=

# 서버 설정(stt/config.yaml 의 rag.kiosks)에 등록된 키오스크 ID
VITE_KIOSK_ID=KIOSK_JONGNO_01

# 타이머는 비워 두면 src/config.js 의 운영 기본값(30초/60초/10초/2.5초/60초, 녹음 상한 25초)이 쓰인다.
