# npm run dev:demo 에서 읽힌다. 발표용 시연 모드 (옮기기 계획 docs/design-implementation-plan.md 5절, 13단계).
# 서버·인터넷·마이크 없이 mock 으로 돈다. 발표자 키(→ ← Home 1~5)는 src/demo/DemoKeys.jsx, 흐름은 src/demo/demoFlows.js
VITE_USE_MOCK=true
VITE_DEMO=true

# 시연 중 끊기지 않게 길게 (10분): 무입력, 무발화, 축소 운영 재점검
VITE_INACTIVITY_MS=600000
VITE_NO_SPEECH_MS=600000
VITE_RECHECK_MS=600000

# 기다림 화면이 1초 넘게 보이게: RESOLVING(stt+resolve 합)·ROUTING 1.5초, FAIL_COUNT_CHECK 1.2초
VITE_MOCK_WAIT_MS=1500
VITE_CHOICE_DELAY_MS=1200

# 나머지(서버 재시도 30초, 무음 2.5초, 녹음 상한 25초)는 src/config.js 의 운영 기본값
